<Window x:Class="PitWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:PitWall.Services"
        xmlns:views="clr-namespace:PitWall"
        mc:Ignorable="d"
        Title="PitWall Replay"
        Height="760"
        Width="1320"
        MinHeight="700"
        MinWidth="1120"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">


    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PitWall Replay"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Playback.FrameText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Session"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Width="128"
                             Height="32"
                             Text="{Binding SessionKeyText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Load"
                            Width="74"
                            Height="32"
                            Margin="8,0,0,0"
                            Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Command="{Binding LoadReplayCommand}" />
                    <Button Content="Find session"
                            Height="32"
                            Margin="8,0,0,0"
                            Command="{Binding OpenSessionFinderCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="18,0,18,14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,14,0">
                    <Button Width="84"
                            Height="34"
                            Content="{Binding Playback.PlayPauseText}"
                            Command="{Binding Playback.PlayPauseCommand}" />
                    <Button Width="70"
                            Height="34"
                            Margin="8,0,0,0"
                            Content="Stop"
                            Command="{Binding Playback.StopCommand}" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Height="24">

                    <ProgressBar
                          Minimum="0"
                          Maximum="{Binding Playback.DurationSeconds}"
                          Value="{Binding Playback.BufferedSeconds, Mode=OneWay}"
                          Height="5"
                          VerticalAlignment="Center"
                          Background="#2A3444"
                          Foreground="#788391"
                          BorderThickness="0"
                          Panel.ZIndex="0"
                          d:Value="75"/>

                    <Slider
                        Minimum="0"
                        Maximum="{Binding Playback.DurationSeconds}"
                        Value="{Binding Playback.CurrentTimeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PlaybackSliderStyle}"
                        Panel.ZIndex="1"
                        VerticalAlignment="Center"
                        d:Value="2" />

                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Playback.CurrentTimeText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               MinWidth="58"
                               TextAlignment="Right" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" / "
                               Foreground="#657083" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Playback.DurationText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               MinWidth="58"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Speed"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="18,0,8,0" 
                               VerticalAlignment="Center"/>
                    <TextBox Width="56"
                             Height="30"
                             Text="{Binding Playback.PlaybackSpeed, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="x"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="18,0,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.95*" MinHeight="250" />
                <RowDefinition Height="14" />
                <RowDefinition Height="1.15*" MinHeight="260" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TrackMap.TrackTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="  Track Map"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#080D14"
                            BorderBrush="#1E2836"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="{x:Static services:TrackMapProjector.DefaultViewportWidth}"
                                  Height="{x:Static services:TrackMapProjector.DefaultViewportHeight}">
                                <Polyline Points="{Binding TrackMap.TrackMapPath}"
                                          Stroke="#496075"
                                          StrokeThickness="4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.85"
                                          IsHitTestVisible="False" />
                                <ItemsControl ItemsSource="{Binding TrackMap.MapMarkers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{x:Static services:TrackMapProjector.DefaultViewportWidth}"
                                                    Height="{x:Static services:TrackMapProjector.DefaultViewportHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left"
                                                    Value="{Binding X}" />
                                            <Setter Property="Canvas.Top"
                                                    Value="{Binding Y}" />
                                            <Setter Property="Visibility"
                                                    Value="Hidden" />
                                            <Setter Property="Opacity"
                                                    Value="1" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform X="-10"
                                                                        Y="-11" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStale}"
                                                             Value="True">
                                                    <Setter Property="Opacity"
                                                            Value="0.22" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Panel.ZIndex"
                                                            Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="58"
                                                  Height="22">
                                                <Ellipse Width="20"
                                                         Height="20"
                                                         HorizontalAlignment="Left"
                                                         Fill="{Binding TeamBrush}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Stroke"
                                                                    Value="Black" />
                                                            <Setter Property="StrokeThickness"
                                                                    Value="1.5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}"
                                                                             Value="True">
                                                                    <Setter Property="Stroke"
                                                                            Value="White" />
                                                                    <Setter Property="StrokeThickness"
                                                                            Value="3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Border Margin="24,1,0,1"
                                                        Padding="4,0"
                                                        Background="#CC0B1018"
                                                        BorderBrush="{Binding TeamBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        DataContext="{Binding Telemetry}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,18">
                            <Border DockPanel.Dock="Left"
                                    Width="7"
                                    Height="42"
                                    Background="{Binding TeamBrush}"
                                    CornerRadius="3"
                                    Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding DriverName, FallbackValue=Select driver}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0">
                                    <Run Text="#" />
                                    <Run Text="{Binding DriverNumber, Mode=OneWay}" />
                                    <Run Text="  P" />
                                    <Run Text="{Binding Position, Mode=OneWay, TargetNullValue=-}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Speed, Mode=OneWay, TargetNullValue=-}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Telemetry"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Throttle"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding Throttle, Mode=OneWay, TargetNullValue=0}"
                                             Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Throttle, TargetNullValue=-, StringFormat={}{0}%}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brake"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding Brake, Mode=OneWay, TargetNullValue=0}"
                                             Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Brake, TargetNullValue=-, StringFormat={}{0}%}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RPM"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding RpmPercent, Mode=OneWay}"
                                             Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Rpm, TargetNullValue=-, StringFormat={}{0:N0}}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Column="2"
                          ItemsSource="{Binding DriverTable.DriverStates}"
                          SelectedItem="{Binding DriverTable.SelectedDriver, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pos" Binding="{Binding Position, TargetNullValue=-}" Width="56" />
                        <DataGridTextColumn Header="No" Binding="{Binding DriverNumber}" Width="56" />
                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="92" />
                        <DataGridTextColumn Header="Speed" Binding="{Binding Speed, TargetNullValue=-}" Width="92" />
                        <DataGridTextColumn Header="Gear" Binding="{Binding Gear, TargetNullValue=-}" Width="64" />
                        <DataGridTextColumn Header="DRS" Binding="{Binding DrsText}" Width="110" />
                        <DataGridTextColumn Header="To Leader" Binding="{Binding Gap, TargetNullValue=-}" Width="90" />
                        <DataGridTextColumn Header="To Ahead" Binding="{Binding Interval}" Width="90" />
                        <DataGridTextColumn Header="Lap" Binding="{Binding Lap, TargetNullValue=-}" Width="64" />
                        <DataGridTextColumn Header="X" Binding="{Binding X, TargetNullValue=-}" Width="90" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, TargetNullValue=-}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="#08101A"
                BorderBrush="#1E2836"
                BorderThickness="1,1,0,0"
                Padding="18,8">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.RowSpan="4"
                Panel.ZIndex="10"
                Background="#B30B0F16">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSessionFinderOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="1040"
                        Height="640"
                        Background="{StaticResource AppBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Session Finder"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Browse Formula 1 weekends, then choose a session to replay."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Back to replay"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Command="{Binding CloseSessionFinderCommand}" />
                        </Grid>
                        <views:SessionFinderView Grid.Row="2"
                                                 DataContext="{Binding SessionFinder}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>